# Copy to .env. docker compose reads it for the whole stack; the API reads it when run on your machine.
# Nothing here is a real secret: change JWT_SECRET and the database password before exposing this anywhere.

# --- Postgres ---
# Compose creates the database with these. Keep the password URL-safe, it is embedded in DATABASE_URL.
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla_dev_password
POSTGRES_DB=tesla_pool
# Port Postgres is published on, on your machine. Inside compose the API always uses db:5432.
DB_PORT=5433

# --- API (npm run dev on your machine; compose builds its own DATABASE_URL from the values above) ---
DATABASE_URL=postgres://tesla:tesla_dev_password@localhost:5433/tesla_pool
# Tests run against this database (created by the test setup). The name must end in _test.
TEST_DATABASE_URL=postgres://tesla:tesla_dev_password@localhost:5433/tesla_pool_test
# Required. Signs the session JWTs; use a long random value anywhere but a local demo.
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SAMESITE=lax
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
# Believe X-Forwarded-For for the client IP: false, a hop count (1), or an address list.
# Keep false unless a real reverse proxy (nginx, a load balancer, a CDN) sits in front and sets it.
# Next.js's /api rewrite does not set it, so trusting it there would let clients forge their IP.
TRUST_PROXY=false
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web ---
# The web app has no variables here. It proxies /api/* to the API; that address (API_URL) defaults to
# http://localhost:4000 for npm run dev, and the Docker build sets it to http://api:4000 (see docker-compose.yml).
