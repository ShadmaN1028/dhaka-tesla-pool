POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla_dev_password
POSTGRES_DB=tesla_pool
DATABASE_URL=postgres://tesla:tesla_dev_password@localhost:5433/tesla_pool
TEST_DATABASE_URL=postgres://tesla:tesla_dev_password@localhost:5433/tesla_pool_test
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Believe X-Forwarded-For for the client IP: false, a hop count (1), or an address list.
# Keep false unless a real reverse proxy (nginx, a load balancer, a CDN) sits in front and sets it.
# Next.js's /api rewrite does not set it, so trusting it there would let clients forge their IP.
TRUST_PROXY=false
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
